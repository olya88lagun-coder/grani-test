# Переменные сайта и воркера. Незаполненные строки удалить или закомментировать:
# пустое значение («KEY=») считается ошибкой настройки, и сайт не запустится.

# --- заполняются при настройке сервера (server-setup.md, раздел 4) ---
APP_URL=https://grani-test.ru
DATABASE_URL=postgres://grani:<пароль из .db_password>@db:5432/grani
SESSION_SECRET=<openssl rand -hex 32>
GHCR_OWNER=olya88lagun-coder
NODE_ENV=production

# --- вписывает владелица сама; секреты никому не присылать ---
TELEGRAM_BOT_TOKEN=<токен бота из @BotFather>
TELEGRAM_BOT_USERNAME=<имя бота без @>
VK_CLIENT_ID=<ID приложения VK ID>

# Сообщество ВК: либо все четыре строки, либо ни одной
#VK_GROUP_ID=241664000
#VK_CALLBACK_SECRET=<придумать>
#VK_CONFIRMATION_CODE=<строка со страницы Callback API>
#VK_GROUP_TOKEN=<ключ доступа сообщества>

# ЮKassa: обе строки или ни одной (без них кнопки оплаты отвечают «Оплата временно недоступна»)
#YOOKASSA_SHOP_ID=<shopId>
#YOOKASSA_SECRET_KEY=<секретный ключ>

# ИИ для разборов: none | yandex | gigachat (none — разборы собираются из блоков)
AI_PROVIDER=none
#YANDEX_API_KEY=<API-ключ сервисного аккаунта>
#YANDEX_FOLDER_ID=<ID каталога>
#GIGACHAT_AUTH_KEY=<ключ авторизации>
#GIGACHAT_SCOPE=GIGACHAT_API_PERS
#NODE_EXTRA_CA_CERTS=/certs/russian_trusted_root_ca.pem

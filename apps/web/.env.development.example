# Скопировать в apps/web/.env.development.local
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
DATABASE_POOL_MAX=1
SESSION_SECRET=local-dev-secret-local-dev-secret-local
VK_CLIENT_ID=1
DEV_LOGIN=1
NOTIFICATIONS_DRY_RUN=1
PAYMENTS_FAKE=1
AI_PROVIDER=none
# Владелица для /admin/receipts: dev-вход под именем «Владелица»
OWNER_IDENTITY=vk:dev-Владелица
